; Optional persistent direct recovery worker. Replace paths/user before installation.
[program:epaper-direct-recovery]
command=/ABSOLUTE/PHP/CLI /ABSOLUTE/APP/ROOT/bin/direct-recovery-worker.php
directory=/ABSOLUTE/APP/ROOT
user=APPLICATION_USER
autostart=true
autorestart=true
startsecs=3
numprocs=1
stopasgroup=true
killasgroup=true
stopwaitsecs=960
redirect_stderr=true
stdout_logfile=/ABSOLUTE/APP/ROOT/storage/logs/direct-recovery.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=2
