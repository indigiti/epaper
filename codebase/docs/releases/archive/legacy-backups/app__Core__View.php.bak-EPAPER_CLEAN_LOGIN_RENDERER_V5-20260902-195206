    private static function authQuote(): array
    {
        $quotes=[
            ['The press is the immune system of democracy.','Roy Greenslade'],
            ['Comment is free, but facts are sacred.','C. P. Scott'],
            ['A good newspaper, I suppose, is a nation talking to itself.','Arthur Miller'],
            ['The newspaper is the first rough draft of history.','Philip L. Graham'],
            ['Freedom of the press is not just important to democracy, it is democracy.','Walter Cronkite'],
            ['The press was to serve the governed, not the governors.','Hugo Black'],
            ['Our Republic and its press will rise or fall together.','Joseph Pulitzer'],
            ['The only security of all is in a free press.','Thomas Jefferson'],
            ['A critical, independent and investigative press is the lifeblood of any democracy.','Nelson Mandela'],
            ['There can be no higher law in journalism than to tell the truth and to shame the devil.','Walter Lippmann'],
            ['A free press can be good or bad, but without freedom a press will never be anything but bad.','Albert Camus'],
            ['The job of the newspaper is to comfort the afflicted and afflict the comfortable.','Finley Peter Dunne']
        ];
        $count=count($quotes);if($count<2)return $quotes[0]??['',''];
        $last=null;if(session_status()===PHP_SESSION_ACTIVE&&isset($_SESSION['epaper_auth_quote_index']))$last=(int)$_SESSION['epaper_auth_quote_index'];
        try{$idx=random_int(0,$count-1);}catch(\Throwable){$idx=(int)(microtime(true)*1000)%$count;}
        if($last!==null&&$idx===$last)$idx=($idx+1)%$count;
        if(session_status()===PHP_SESSION_ACTIVE)$_SESSION['epaper_auth_quote_index']=$idx;
        return $quotes[$idx];
    }
    private static function authFormIsolated(string $html): string
    {
        // Authentication markup originally uses global auth classes from app.css.
        // Rename them for this surface so legacy v1.1.9.x rules cannot change
        // the card geometry in real browsers or at non-100% browser zoom.
        return str_replace(
            [
                'class="btn primary auth-submit"',
                'class="auth-panel"',
                'class="auth-brand"',
                'class="eyebrow"',
                'class="muted"',
                'class="auth-form"',
                'class="auth-security"',
                'class="auth-error"'
            ],
            [
                'class="auth-fit-submit"',
                'class="auth-fit-panel"',
                'class="auth-fit-legacy-brand"',
                'class="auth-fit-eyebrow"',
                'class="auth-fit-muted"',
                'class="auth-fit-fields"',
                'class="auth-fit-security"',
                'class="auth-fit-error"'
            ],
            $html
        );
    }
    private static function authExperience(string $formBody,string $brand,bool $hasTenant,string $logo,string $logoDark): string
    {
        $square=$hasTenant&&class_exists(TenantData::class)?trim((string)TenantData::setting('brand.square_mark_path','')):'';
        if($logo!=='')$identity='<span class="auth-fit-logo-stack"><img class="auth-fit-logo auth-fit-logo-light" src="'.self::e($logo).'" alt="'.self::e($brand).'"><img class="auth-fit-logo auth-fit-logo-dark" src="'.self::e($logoDark!==''?$logoDark:$logo).'" alt="'.self::e($brand).'"></span>';
        elseif($square!=='')$identity='<span class="auth-fit-identity"><img class="auth-fit-mark" src="'.self::e($square).'" alt=""><strong>'.self::e($brand).'</strong></span>';
        else{$letter=function_exists('mb_substr')?mb_substr(trim($brand),0,1):substr(trim($brand),0,1);$identity='<span class="auth-fit-identity"><span class="auth-fit-monogram" aria-hidden="true">'.self::e(strtoupper($letter?:'E')).'</span><strong>'.self::e($brand).'</strong></span>';}
        [$quote,$author]=self::authQuote();
        $isolated=self::authFormIsolated($formBody);
        $quoteHtml='<figure class="auth-fit-quote-card" aria-label="Editorial quote"><span class="auth-fit-quote-mark" aria-hidden="true">“</span><blockquote>'.self::e($quote).'</blockquote><figcaption>— '.self::e($author).'</figcaption></figure>';
        // v1.1.9.11: remove the legacy auth panel wrapper from layout completely.
        // Some live themes/inline rules can force that wrapper to a viewport-like height;
        // direct-flow children make the reported upper/middle/lower blank zones impossible.
        $content=$isolated;
        if(preg_match('/<section\b[^>]*class="[^"]*\bauth-fit-panel\b[^"]*"[^>]*>(.*)<\/section>\s*$/is',$isolated,$m))$content=$m[1];
        // Do not allow inline geometry from legacy form markup to survive into the compact surface.
        $content=preg_replace('/(<(?:form|div)\b[^>]*class="[^"]*\bauth-fit-fields\b[^"]*"[^>]*)\sstyle=(?:"[^"]*"|\'[^\']*\')/i','$1',$content)??$content;
        return '<section class="auth-fit auth-fit-v11911" data-auth-version="1.1.9.11">'
            .'<a class="auth-fit-brand" href="/" aria-label="'.self::e($brand).' home">'.$identity.'</a>'
            .'<div class="auth-fit-orbit auth-fit-orbit-one" aria-hidden="true"></div><div class="auth-fit-orbit auth-fit-orbit-two" aria-hidden="true"></div>'
            .'<div class="auth-fit-cloud auth-fit-cloud-one" aria-hidden="true"></div><div class="auth-fit-cloud auth-fit-cloud-two" aria-hidden="true"></div>'
            .'<div class="auth-fit-card" style="height:auto!important;min-height:0!important;max-height:none!important;align-self:center!important;flex:none!important">'
                .'<div class="auth-fit-icon" aria-hidden="true">'.self::icon('user').'</div>'
                .'<div class="auth-fit-content">'.$content.$quoteHtml.'</div>'
            .'</div>'
        .'</section>';
    }
