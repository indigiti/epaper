; EP-DI v2.0.0-alpha.2.3 — generic Supervisor example
; BEST OPTION: open /admin/system/infrastructure/supervisor and download the
; server-specific configuration generated from the actual deployed APP_ROOT.
;
; Replace <APP_ROOT> only when using this generic template.
; Example Cloudways outer application root:
; /home/master/applications/<APP_ID>/public_html

[program:epaper-outbox]
command=php <APP_ROOT>/bin/outbox-publisher.php
directory=<APP_ROOT>
autostart=true
autorestart=true
startsecs=3
startretries=5
numprocs=1
redirect_stderr=true
stdout_logfile=<APP_ROOT>/storage/logs/outbox.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=5
stopwaitsecs=30
stopsignal=TERM
stopasgroup=true
killasgroup=true

[program:epaper-render]
command=php <APP_ROOT>/bin/rabbit-worker.php --lane=render --max-jobs=250
directory=<APP_ROOT>
autostart=true
autorestart=true
startsecs=3
startretries=5
numprocs=1
redirect_stderr=true
stdout_logfile=<APP_ROOT>/storage/logs/render-worker.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=5
stopwaitsecs=60
stopsignal=TERM
stopasgroup=true
killasgroup=true

[program:epaper-assets]
command=php <APP_ROOT>/bin/rabbit-worker.php --lane=assets --max-jobs=250
directory=<APP_ROOT>
autostart=true
autorestart=true
startsecs=3
startretries=5
numprocs=2
process_name=%(program_name)s_%(process_num)02d
redirect_stderr=true
stdout_logfile=<APP_ROOT>/storage/logs/assets-worker.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=5
stopwaitsecs=60
stopsignal=TERM
stopasgroup=true
killasgroup=true

[program:epaper-ocr]
command=php <APP_ROOT>/bin/rabbit-worker.php --lane=ocr --max-jobs=250
directory=<APP_ROOT>
autostart=true
autorestart=true
startsecs=3
startretries=5
numprocs=1
redirect_stderr=true
stdout_logfile=<APP_ROOT>/storage/logs/ocr-worker.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=5
stopwaitsecs=360
stopsignal=TERM
stopasgroup=true
killasgroup=true

[program:epaper-finalize]
command=php <APP_ROOT>/bin/rabbit-worker.php --lane=finalize --max-jobs=250
directory=<APP_ROOT>
autostart=true
autorestart=true
startsecs=3
startretries=5
numprocs=1
redirect_stderr=true
stdout_logfile=<APP_ROOT>/storage/logs/finalize-worker.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=5
stopwaitsecs=60
stopsignal=TERM
stopasgroup=true
killasgroup=true
